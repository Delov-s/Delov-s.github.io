<mdui-card clickable variant="filled" href="<%- url_for(post.path) %>"
    style="width:100%;">
    <%if(post.cover){%>
    <div style="width: 100%;height: 128px;background-repeat: no-repeat;background-size: cover;background-position: center;background-image: url(<%-post.cover%>);">
    </div>
    <%}%>
    <div class="mdui-prose" style="padding: 16px;">
        <h1 style="margin-bottom: 8px;">
            <%= post.title %>
        </h1>
        <span class="post-date">
            <mdui-icon name="date_range" style="vertical-align: text-bottom;font-size: 18px;"></mdui-icon>
            <%= full_date(post.date) %> &nbsp; <mdui-icon name="update"
                    style="vertical-align: text-bottom;font-size: 18px;"></mdui-icon>
                <%= full_date(post.updated) %>
        </span>
        <br>
        <%
            const postCategories = post.categories ? (typeof post.categories.toArray === 'function' ? post.categories.toArray() : (Array.isArray(post.categories) ? post.categories : [])) : [];
            const postTags = post.tags ? (typeof post.tags.toArray === 'function' ? post.tags.toArray() : (Array.isArray(post.tags) ? post.tags : [])) : [];
        %>
        <%if(postCategories.length){%><span><%=__("category")%> <% postCategories.forEach(function (cate) { %>
                    <a href="<%- url_for(cate.path) %>">
                        <%= cate.name %>
                    </a>
                    <% }); %>
            </span>
            <%}%>
                <%if(postTags.length){%><span>| <%=__("tag")%> <% postTags.forEach(function (tag) { %>
                        <a href="<%- url_for(tag.path) %>" variant="filter">
                            <%= tag.name %>
                        </a>
                        <% }); %></span>
                            <% }%>

                <p>
                    <%if(post.excerpt){%>
                        <%= strip_html(post.excerpt) %>
                            <%}else{%>
                                <%- truncate(strip_html(post.content),{length:100}) %>
                                    <%}%>
                </p>
    </div>
</mdui-card>

